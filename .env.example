# Copy to .env for local development. Every value here is the default, so an
# empty .env behaves exactly like no .env at all.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Outbound HTTP. TIMEOUT_MS=0 disables the timeout (local debugging only).
HTTP_TIMEOUT_MS=5000
HTTP_RETRY_ATTEMPTS=3

# Rate limiting. Set RATE_LIMIT_PER_MINUTE=0 to turn the limiter off — that is
# the emergency lever and how the load tests run.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20

# Payments provider
PAYMENTS_BASE_URL=https://payments.example.test
PAYMENTS_API_KEY=sk_test_local
PAYMENTS_WEBHOOK_SECRET=whsec_test_local

# Transactional email. With no API key, sends are logged instead of delivered.
EMAIL_BASE_URL=https://email.example.test
EMAIL_API_KEY=key_test_local
EMAIL_FROM=orders@orderflow.example

# Carrier aggregator
SHIPPING_BASE_URL=https://ship.example.test
SHIPPING_API_KEY=ship_test_local

# Operational alerts. Empty = log instead of posting.
SLACK_ALERT_WEBHOOK=

# Background jobs
ABANDONED_CART_AFTER_MINUTES=60
RESERVATION_TTL_MINUTES=30
DUNNING_MAX_ATTEMPTS=4

# Feature flags
FLAG_REGIONAL_TAX=true
FLAG_FRAUD_MANUAL_REVIEW=true
FLAG_RESERVE_AT_CART=false
FLAG_NEW_SHIPMENT_EMAIL=false
FLAG_LOCAL_SEARCH_INDEX=true
